          }
        },
        "summary": "Delete a chat session",
        "tags": ["Chat Sessions"]
      }
    },
    "/auth/keycloak/login": {
      "get": {
        "description": "Redirects the user to Keycloak login page with proper OAuth2 parameters. This endpoint starts the SSO authentication process.",
        "operationId": "KeycloakController_login",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirects to Keycloak login page. The response will contain a Location header with the Keycloak authorization URL."
          }
        },
        "summary": "Initiate Keycloak login flow",
        "tags": ["Authentication"]
      }
    },
    "/auth/keycloak/callback": {
      "get": {
        "description": "Processes the OAuth2 callback from Keycloak after successful authentication. This endpoint should be registered as the OAuth2 redirect URI in Keycloak.",
        "operationId": "KeycloakController_callback",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "description": "Authorization code from Keycloak",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "description": "State parameter for CSRF protection, must match the state from login",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Authentication successful, redirects to dashboard with established session"
          },
          "401": {
            "description": "Invalid state parameter or authentication failed"
          }
        },
        "summary": "Handle Keycloak callback",
        "tags": ["Authentication"]
      }
    },
    "/auth/keycloak/refresh": {
      "post": {
        "description": "Uses the refresh token to obtain a new access token when the current one expires.",
        "operationId": "KeycloakController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tokens refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "No refresh token available or refresh failed"
          }
        },
        "summary": "Refresh access token",
        "tags": ["Authentication"]
      }
    },
    "/auth/keycloak/logout": {
      "post": {
        "description": "Logs out the user from both the application and Keycloak SSO. This will invalidate all sessions.",
        "operationId": "KeycloakController_logout",
        "parameters": [
          {
            "name": "redirect_uri",
            "required": false,
            "in": "query",
            "description": "Optional URL to redirect to after logout",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successfully logged out, redirects to Keycloak logout page or specified redirect URI"
          }
        },
        "summary": "Logout user",
        "tags": ["Authentication"]
      }
    },
    "/auth/keycloak/status": {
      "get": {
        "description": "Returns whether the user is currently authenticated based on session state.",
        "operationId": "KeycloakController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns authentication status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check authentication status",
        "tags": ["Authentication"]
      }
    }
  },
  "info": {
    "title": "Nflow Chat Assistant API",
    "description": "API for the Nflow Chat Assistant that interprets user prompts and interacts with the Nflow no-code platform",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Unique identifier for the chat session",
            "example": "abc123"
          },
          "message": {
            "type": "string",
            "description": "Message content from the user",
            "example": "Build a task manager app with login and calendar"
          }
        },
        "required": ["sessionId", "message"]
      },
      "ChatResponseDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "Unique identifier for the chat session",
            "example": "abc123"
          },
          "reply": {
            "type": "string",
            "description": "The reply message from the AI assistant",
            "example": "Your app is ready! Here's the link to view it in Nflow."
          },
          "appUrl": {
            "type": "string",
            "description": "URL to the created application in Nflow",
            "example": "https://nflow.so/app/xyz456"
          }
        },
        "required": ["sessionId", "reply"]
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "The unique identifier of the chat session",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "content": {
            "type": "string",
            "description": "The content of the message",
            "example": "Can you build me a CRM app?"
          },
          "role": {
            "type": "string",
            "description": "The role of the message sender",
            "enum": ["USER", "ASSISTANT", "SYSTEM", "DEVELOPER"],
            "example": "USER",
            "default": "USER"
          }
        },
        "required": ["sessionId", "content", "role"]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier of the message",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "sessionId": {
            "type": "string",
            "description": "The unique identifier of the chat session",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "content": {
            "type": "string",
            "description": "The content of the message",
            "example": "Can you build me a CRM app?"
          },
          "role": {
            "type": "string",
            "description": "The role of the message sender",
            "enum": ["USER", "ASSISTANT", "SYSTEM", "DEVELOPER"],
            "example": "USER"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "The timestamp when the message was created",
            "example": "2023-04-08T12:34:56.789Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "The timestamp when the message was last updated",
            "example": "2023-04-08T12:34:56.789Z"
          }
        },
        "required": [
          "id",
          "sessionId",
          "content",
          "role",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateMessageDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "The content of the message",
            "example": "Can you build me a CRM app with user authentication?"
          }
        },
        "required": ["content"]
      },
      "DeleteMessageResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the message was successfully deleted",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "The message returned from the operation",
            "example": "Message deleted successfully"
          }
        },
        "required": ["success", "message"]
      },
      "CreateChatSessionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the chat session",
            "example": "Task Manager App Discussion"
          }
        },
        "required": ["title"]
      },
      "UpdateChatSessionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the chat session",
            "example": "Task Manager App Discussion"
          },
          "archived": {
            "type": "boolean",
            "description": "Whether the chat session is archived",
            "example": true
          }
        }
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access token for API calls",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "description": "Token used to refresh the access token",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "idToken": {
            "type": "string",
            "description": "OpenID Connect ID token containing user information",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": ["accessToken", "refreshToken", "idToken"]
      },
      "AuthStatusResponseDto": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "Whether the user is currently authenticated",
            "example": true
          }
        },
        "required": ["authenticated"]
      }
    }
  }
}
