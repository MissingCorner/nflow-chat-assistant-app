        "tags": ["Chat Sessions"]
      },
      "delete": {
        "operationId": "ChatSessionController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
